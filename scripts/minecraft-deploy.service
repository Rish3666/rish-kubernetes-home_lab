[Unit]
Description=Deploy Minecraft Fabric server manifests
Wants=network-online.target k3s.service
After=network-online.target k3s.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/rishlab/mc-k8s
ExecStart=/bin/sh /home/rishlab/mc-k8s/deploy.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
